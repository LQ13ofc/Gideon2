 "defects": [
  {
   "id": "D1",
   "stage": "recorder (src/live.rs recorder_args)",
   "symptom": "live input never produced a wake: capture started, no detection",
   "root_cause": "pw-record writing to \"-\" emits an AU container (\".snd\", 24-byte header, big-endian samples). The Core and worker read it as little-endian s16, so the worker received byte-swapped noise (measured rms 11428, peak 32768 against a true rms 1524, peak 12686).",
   "fix": "add --raw to pw-record arguments (parecord already used --raw).",
   "evidence": "lab sandbox_probe header vs raw inside the same bwrap shape; chain_probe raw: xcorr 0.999 with the source clip, worker detects hey_gideon",
   "test": "src/live.rs recorder_args exact-argv unit test"
  },
  {
   "id": "D2",
   "stage": "player (src/live.rs player_args)",
   "symptom": "speech output: live player wrote some PCM, then output_state=error player_write_failed mid-speech",
   "root_cause": "pw-play reading stdin without --raw parses it as a sound file: \"sndfile: failed to open audio file -: Format not recognised\", exit 1.",
   "fix": "add --raw to pw-play arguments.",
   "evidence": "direct test: no --raw rc=1, --raw rc=0; output_check before fix: playing->error; after fix: playing->idle, speech completed",
   "test": "src/live.rs player_args unit test (first argument --raw)"
  },
  {
   "id": "D3",
   "stage": "live worker sandbox (src/live.rs spawn_worker)",
   "symptom": "latent: live worker would fail to load models when its assets are outside the bound home",
   "root_cause": "live worker mounted only the manifest; the replay profile also mounts asset_root (and the VAD directory lives outside the wake asset root in some layouts).",
   "fix": "worker_mounts() mounts asset_root and the VAD model directory named by the manifest (optional fields, absolute paths required).",
   "evidence": "not triggered in the packaged layout (assets sit under the bound home); reproduced by reading the mount list; repo-layout runs show the same missing-asset class of failure in STT",
   "test": "src/live.rs worker_mounts_include_assets_and_vad_directory"
  },
  {
   "id": "D4",
   "stage": "wake engine start (scripts/wake_worker.py, live only)",
   "symptom": "speech in the first seconds after the worker starts (boot, preference change, restart) is missed",
   "root_cause": "a freshly created keyword stream has no encoder history; phrases that start within the first ~2-4 s of the stream are often not detected. Measured: 28/51 positives with 1 s of lead, 47/51 with 4 s of lead, same audio, same threshold.",
   "fix": "WakeEngine.warm_up() primes the stream with 3 s of silence before the first Core frame (live only). Detections while priming are discarded; stream_start_us moves back by the priming length so detection times stay on the Core clock.",
   "evidence": "offline cold probe 1 s lead: 28/51 -> 47/51 with warm-up. Live cold-start A/B (fresh Core, clip 0.3 s after capture starts): package worker 0/6, warm-up worker 6/6.",
   "test": "scripts/test_wake_worker.py test_warm_up_keeps_the_core_clock_and_emits_nothing"
  },
  {
   "id": "D5",
   "stage": "command grammar (src/commands.rs parse)",
   "symptom": "wake fired and the transcript was right, but no command ran (e.g. \"Hey, Gideon, open brave.\")",
   "root_cause": "STT inserts a comma after the first wake word; the literal prefix \"hey gideon\" did not match \"hey, gideon\".",
   "fix": "unify_wake_comma: one comma after the first wake word is read as a space. Every other comma keeps the exact grammar (\"open, brave\" is still refused).",
   "evidence": "run A (before fix): open-brave command_success 7 of 15 wake hits at sensitivity 1.0; run B (after fix): 19 of 21",
   "test": "src/commands.rs stt_comma_after_wake_word_is_the_only_comma_accepted"
  }
 ],
