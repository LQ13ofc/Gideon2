#!/usr/bin/env python3
"""Verify a gideon-base package against PACKAGE.json (stdlib only). Fails closed.

Exit 0 only for an exact match: every listed entry present with the listed type, size, mode and
sha256; no symlink escaping the package prefix; every regular file has st_nlink == 1 (no hard
link aliases); every directory on disk is an expected one (an ancestor of a listed entry or a
listed "dir" entry), and every directory could be listed (unreadable directories fail); no extra
entry of any kind. Regular files are opened with O_NOFOLLOW|O_NONBLOCK after an lstat check and
the descriptor is re-checked with fstat, so FIFOs and device nodes are refused without blocking.
Prints the first mismatch and exits 1 otherwise.

Scope limit: this file judges the package it lives in. Whoever can rewrite this file can also
rewrite the verdict. gideon-install pins its sha256 in the ledger; see docs/B4.md (B4.3 signing).
"""
import hashlib
import json
import os
import stat
import sys
from pathlib import PurePosixPath

PREFIX = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MANIFEST = "PACKAGE.json"
MAX_MANIFEST = 64 << 20


def fail(message):
    print(f"gideon-verify: FAIL: {message}", file=sys.stderr)
    sys.exit(1)


def open_regular(path, rel):
    """Open a regular file: lstat check, O_NOFOLLOW|O_NONBLOCK open, fstat recheck. Returns (handle, st)."""
    try:
        before = os.lstat(path)
    except OSError:
        fail(f"missing: {rel}")
    if not stat.S_ISREG(before.st_mode):
        fail(f"not a regular file: {rel}")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as exc:
        fail(f"cannot open {rel}: {exc.strerror}")
    handle = os.fdopen(fd, "rb")
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or (st.st_dev, st.st_ino) != (before.st_dev, before.st_ino):
        handle.close()
        fail(f"not a regular file or changed while opening: {rel}")
    return handle, st


def digest(path, rel):
    handle, st = open_regular(path, rel)
    h = hashlib.sha256()
    with handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest(), st


def safe_relpath(path):
    if not isinstance(path, str) or not path or path.startswith("/") or "\\" in path:
        return False
    parts = PurePosixPath(path).parts
    return not any(p in ("", ".", "..") for p in parts)


def inside_prefix(path):
    return path == "." or not (path == ".." or path.startswith("../") or path.startswith("/"))


def normalize(path):
    out = []
    for part in path.split("/"):
        if part in ("", "."):
            continue
        if part == "..":
            if not out:
                return None
            out.pop()
        else:
            out.append(part)
    return "/".join(out)


def check_parents(rel):
    """No symlink or non-directory component between the prefix and the entry."""
    current = PREFIX
    for part in PurePosixPath(rel).parts[:-1]:
        current = os.path.join(current, part)
        try:
            st = os.lstat(current)
        except OSError:
            fail(f"missing parent of {rel}")
        if not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
            fail(f"parent is not a plain directory: {rel}")


def on_walk_error(err):
    where = os.path.relpath(err.filename, PREFIX) if err.filename else "?"
    fail(f"cannot list directory {where}: {err.strerror}")


LEXICON_TEMPLATE = "templates/lexicon.json"
PREFIX_TOKEN = "@PREFIX@/"


def check_lexicon(expected):
    """When the package carries templates/lexicon.json, the lexicon it pins must be a listed regular file
    whose PACKAGE.json sha256 equals the pin (gideon-configure declares it to the Core for custom phrases)."""
    if LEXICON_TEMPLATE not in expected:
        return
    handle, _ = open_regular(os.path.join(PREFIX, LEXICON_TEMPLATE), LEXICON_TEMPLATE)
    with handle:
        try:
            template = json.loads(handle.read(65536).decode("utf-8"))
        except (UnicodeDecodeError, ValueError):
            fail("templates/lexicon.json is not valid JSON")
    path = template.get("path") if isinstance(template, dict) else None
    pin = template.get("sha256") if isinstance(template, dict) else None
    if not isinstance(path, str) or not path.startswith(PREFIX_TOKEN) or not isinstance(pin, str):
        fail("templates/lexicon.json needs a path under @PREFIX@/ and a sha256")
    rel = path[len(PREFIX_TOKEN):]
    listed = expected.get(rel)
    if listed is None or listed.get("type", "file") != "file":
        fail(f"lexicon not listed in PACKAGE.json: {rel}")
    if listed.get("sha256") != pin:
        fail(f"lexicon pin differs from PACKAGE.json: {rel}")


def verify():
    manifest_path = os.path.join(PREFIX, MANIFEST)
    handle, _ = open_regular(manifest_path, MANIFEST)
    with handle:
        raw = handle.read(MAX_MANIFEST + 1)
    if len(raw) > MAX_MANIFEST:
        fail("PACKAGE.json is too large")
    data = json.loads(raw.decode("utf-8"))
    entries = data.get("files") if isinstance(data, dict) else None
    if not isinstance(entries, list) or not entries:
        fail("PACKAGE.json has no files list")

    expected = {}
    expected_dirs = set()
    for entry in entries:
        if not isinstance(entry, dict):
            fail("PACKAGE.json entry is not an object")
        rel = entry.get("path")
        if not safe_relpath(rel) or rel in expected or rel == MANIFEST:
            fail(f"invalid or duplicate entry path: {rel!r}")
        expected[rel] = entry
    for rel, entry in expected.items():
        if entry.get("type", "file") not in ("file", "symlink", "dir"):
            fail(f"unknown entry type for {rel}")
        parts = PurePosixPath(rel).parts
        for i in range(1, len(parts)):
            expected_dirs.add("/".join(parts[:i]))
    expected_dirs.update(rel for rel, e in expected.items() if e.get("type") == "dir")

    # Pass 1: every listed entry matches exactly.
    total_bytes = 0
    for rel in sorted(expected):
        entry = expected[rel]
        kind = entry.get("type", "file")
        full = os.path.join(PREFIX, rel)
        check_parents(rel)
        if kind == "dir":
            try:
                st = os.lstat(full)
            except OSError:
                fail(f"missing directory: {rel}")
            if not stat.S_ISDIR(st.st_mode):
                fail(f"not a directory: {rel}")
            continue
        try:
            st = os.lstat(full)
        except OSError:
            fail(f"missing: {rel}")
        if kind == "symlink":
            target = entry.get("target")
            if not stat.S_ISLNK(st.st_mode):
                fail(f"not a symlink: {rel}")
            if os.readlink(full) != target or not isinstance(target, str) or target.startswith("/"):
                fail(f"symlink target changed or absolute: {rel}")
            resolved = normalize(os.path.dirname(rel) + "/" + target if os.path.dirname(rel) else target)
            if resolved is None or not inside_prefix(resolved):
                fail(f"symlink escapes prefix: {rel} -> {target}")
            # Follow the chain of packaged symlinks; it must end at a packaged regular file.
            hops = 0
            while True:
                node = expected.get(resolved)
                if node is None:
                    # A directory is valid when packaged files live under it.
                    if any(k.startswith(resolved + "/") for k in expected):
                        break
                    fail(f"symlink target is not packaged: {rel} -> {target}")
                if node.get("type", "file") == "file":
                    break
                if node.get("type") == "dir":
                    break
                hops += 1
                if hops > 8:
                    fail(f"symlink chain too deep: {rel}")
                next_target = node.get("target", "")
                if not isinstance(next_target, str) or next_target.startswith("/"):
                    fail(f"absolute symlink in chain: {resolved}")
                resolved = normalize(os.path.dirname(resolved) + "/" + next_target if os.path.dirname(resolved) else next_target)
                if resolved is None or not inside_prefix(resolved):
                    fail(f"symlink chain escapes prefix: {rel}")
            continue
        if kind != "file":
            fail(f"unknown entry type for {rel}")
        if not stat.S_ISREG(st.st_mode):
            fail(f"not a regular file: {rel}")
        if st.st_nlink != 1:
            fail(f"hard link alias (st_nlink {st.st_nlink}): {rel}")
        if st.st_size != entry.get("size"):
            fail(f"size mismatch: {rel} ({st.st_size} != {entry.get('size')})")
        if stat.S_IMODE(st.st_mode) != int(str(entry.get("mode")), 8):
            fail(f"mode mismatch: {rel}")
        got, opened = digest(full, rel)
        if opened.st_nlink != 1:
            fail(f"hard link alias (st_nlink {opened.st_nlink}): {rel}")
        if got != entry.get("sha256"):
            fail(f"sha256 mismatch: {rel}")
        total_bytes += st.st_size

    check_lexicon(expected)

    # Pass 2: nothing extra anywhere in the prefix; every directory listable and expected.
    for root, dirs, files in os.walk(PREFIX, onerror=on_walk_error, followlinks=False):
        for name in dirs + files:
            full = os.path.join(root, name)
            rel = os.path.relpath(full, PREFIX).replace(os.sep, "/")
            try:
                st = os.lstat(full)
            except OSError:
                fail(f"cannot inspect: {rel}")
            if stat.S_ISDIR(st.st_mode):
                if rel not in expected_dirs:
                    fail(f"extra directory not in PACKAGE.json: {rel}")
                continue
            if rel == MANIFEST:
                continue
            if rel not in expected:
                fail(f"extra entry not in PACKAGE.json: {rel}")

    print(f"gideon-verify: OK {len(expected)} entries, {total_bytes} bytes regular files")
    return 0


def main():
    if sys.argv[1:]:
        fail("usage: gideon-verify (takes no arguments; verifies the package it lives in)")
    try:
        return verify()
    except SystemExit:
        raise
    except Exception as exc:  # fail closed on anything unexpected
        fail(f"internal error: {exc.__class__.__name__}: {exc}")


if __name__ == "__main__":
    sys.exit(main())
