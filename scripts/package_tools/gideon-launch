#!/usr/bin/env python3
"""gideon-launch --install-root ROOT PERFIL [core args...]: fail-closed launcher (B4.2/B4.3).

Takes a SHARED lock on ROOT/.lock and passes that fd to the Core, so the lock lives as long as the
Core (install/update/rollback/repair take the exclusive lock and wait or refuse meanwhile).
Validates the ledger and layout (gideon-install's rules, including the verifier pin), verifies the
current version with its gideon-verify, creates ROOT/profiles/PERFIL (0700) if missing, then runs
current/bin/gideon-core ROOT/profiles/PERFIL [args] with GIDEON_PINNED_VERIFIER_SHA256 set.
The launcher stays as the Core's supervisor: when the Core exits with 75 (an accepted core_restart,
after its ledgers are flushed) it starts the Core again with the same arguments. At most 3 restarts
per 60 s; a fourth stops with `restart_limit` and exit 8. Any other exit status is passed through.
SIGTERM/SIGINT are forwarded to the Core, and the Core gets SIGTERM if the launcher dies.
Core options the package pins (--root --home --base-pack --tts-virtual --wake-replay
--commands-sandbox --plugin-python --data-dir, also as --opt=value) are rejected with exit 2.
Any inconsistency exits non-zero with a message on stderr and never starts the Core. Stdlib only;
reuses gideon-install from the same directory.
"""
import argparse
import collections
import importlib.machinery
import importlib.util
import os
import signal
import stat
import subprocess
import sys
import time

sys.dont_write_bytecode = True  # never create bin/__pycache__ inside the package
HERE = os.path.dirname(os.path.abspath(__file__))
# Options gideon-core sets itself. Keep in sync with scripts/package_tools/gideon-core.
PINNED_OPTIONS = ("--root", "--home", "--base-pack", "--tts-virtual", "--wake-replay",
                  "--commands-sandbox", "--plugin-python", "--data-dir")
PIN_ENV = "GIDEON_PINNED_VERIFIER_SHA256"
# Exit status of a Core that accepted core_restart (transport::RESTART_EXIT_CODE in src/transport.rs).
RESTART_EXIT = 75
RESTART_WINDOW = 60.0  # seconds
RESTART_LIMIT = 3  # restarts allowed inside one window; the next request stops the launcher
RESTART_REFUSED = 8  # exit status when the restart budget is exhausted


def load_installer():
    path = os.path.join(HERE, "gideon-install")
    loader = importlib.machinery.SourceFileLoader("gideon_install", path)
    spec = importlib.util.spec_from_loader("gideon_install", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


gi = load_installer()


def reject_pinned(core_args):
    for arg in core_args:
        for option in PINNED_OPTIONS:
            if arg == option or arg.startswith(option + "="):
                raise gi.Fail("usage", f"{option} is set by the package; remove it from the arguments", rc=2)


def _die_with_parent():
    """Child side: SIGTERM when the launcher dies, so an orphaned Core still shuts down cleanly."""
    try:
        import ctypes
        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG (Linux)
    except (OSError, AttributeError):
        pass


def run_once(argv, env, pass_fds, state):
    """Runs the Core once as a child and returns its status (negative: killed by a signal)."""
    child = subprocess.Popen(argv, env=env, pass_fds=pass_fds, preexec_fn=_die_with_parent)
    state["child"] = child
    if state.get("stop"):  # a signal arrived before the child was registered: deliver it now
        child.send_signal(signal.SIGTERM)
    try:
        return child.wait()
    finally:
        state["child"] = None


def supervise(argv, env, pass_fds, *, run=run_once, now=time.monotonic, state=None):
    """Starts the Core and restarts it on RESTART_EXIT, at most RESTART_LIMIT times per window.

    `run(argv, env, pass_fds, state)` returns the Core's status; `state["stop"]` is set by a
    forwarded signal, and then the Core is not restarted. Returns the status to exit with.
    """
    state = {} if state is None else state
    restarts = collections.deque()
    while True:
        status = run(argv, env, pass_fds, state)
        if status < 0:
            status = 128 - status  # killed by a signal: the conventional shell status
        if status != RESTART_EXIT or state.get("stop"):
            return status
        t = now()
        while restarts and t - restarts[0] >= RESTART_WINDOW:
            restarts.popleft()
        if len(restarts) >= RESTART_LIMIT:
            sys.stderr.write("gideon-launch: restart_limit: the Core asked to restart too often; stopped\n")
            return RESTART_REFUSED
        restarts.append(t)
        sys.stderr.write("gideon-launch: core restarted on request\n")


def _forward_signal(state):
    def handler(signum, _frame):
        state["stop"] = True
        child = state.get("child")
        if child is not None and child.poll() is None:
            child.send_signal(signum)
    return handler


def main(argv):
    parser = argparse.ArgumentParser(prog="gideon-launch")
    parser.add_argument("--install-root", required=True, metavar="ROOT")
    parser.add_argument("profile", metavar="PERFIL")
    parser.add_argument("core_args", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    try:
        gi.validate_profile(args.profile)
        reject_pinned(args.core_args)
        root = gi.guard_root(args.install_root, create=False)
        lock_fd = gi.acquire(root, shared=True)
        os.set_inheritable(lock_fd, True)  # held for the Core's lifetime: passed via pass_fds
        ledger = gi.load_state(root)
        if ledger is None:
            raise gi.Fail("not_installed", "nothing installed; run gideon-install install first")
        pin = gi.entry_for(ledger, ledger["current"])["verifier_sha256"]
        gi.verify_pkg(os.path.join(root, "versions", ledger["current"]))
        pdir = os.path.join(root, "profiles")
        if not os.path.lexists(pdir):
            try:
                os.mkdir(pdir, 0o700)
                os.chmod(pdir, 0o700)
            except FileExistsError:
                pass
        elif not gi.is_real_dir(pdir):
            raise gi.Fail("layout_invalid", "profiles must be a real directory")
        profile = os.path.join(pdir, args.profile)
        if not os.path.lexists(profile):
            try:
                os.mkdir(profile, 0o700)
                os.chmod(profile, 0o700)
            except FileExistsError:
                pass
        gi.check_profile_dir(profile)
        core = os.path.join(root, "current", "bin", "gideon-core")
        st = os.stat(core)
        if not stat.S_ISREG(st.st_mode) or not os.access(core, os.X_OK):
            raise gi.Fail("verify_failed", "current/bin/gideon-core is not an executable file", rc=4)
    except gi.Fail as fail:
        sys.stderr.write(f"gideon-launch: {fail.code}: {fail.message}\n")
        return fail.rc
    except OSError as exc:
        sys.stderr.write(f"gideon-launch: other: {exc}\n")
        return 6
    sys.stdout.flush()
    os.environ[PIN_ENV] = pin
    state = {"stop": False, "child": None}
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, _forward_signal(state))
    return supervise([core, profile, *args.core_args], dict(os.environ), (lock_fd,), state=state)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
